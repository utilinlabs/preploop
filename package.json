{
  "name": "preploop",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run check:scripts",
    "check:scripts": "tsc --project ./tsconfig.scripts.json --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:release": "bun test scripts/release.test.ts",
    "test:coverage": "vitest run --coverage",
    "version:check": "bun scripts/check-version.ts",
    "model:fetch": "bun scripts/fetch-model.ts",
    "dev:setup": "bun scripts/dev-setup.ts",
    "bundle:prepare": "bun run model:fetch && bun run build",
    "tauri": "bun run dev:setup && tauri",
    "tauri:build": "tauri build --bundles app -- --bin PrepLoop"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "bits-ui": "^2.19.0",
    "katex": "^0.18.4",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.2.1"
  }
}
